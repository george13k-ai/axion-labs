# Copy to .env and fill in. Never commit .env.
PORT=3000
# Public address of the site, without a trailing slash. Used in canonical, Open Graph, sitemap and the origin check.
SITE_URL=https://example.ru
# Telegram bot that receives leads: create one with @BotFather, add it to the chat and put the chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set to 1 when the site runs behind nginx or another proxy that sets X-Forwarded-For.
TRUST_PROXY=0
